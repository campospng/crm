# URL pública do CRM após o primeiro deploy.
VITE_APP_URL=http://localhost:8443

# Futuras credenciais da API WhatsApp Business Cloud.
# Nunca use o prefixo VITE_ para segredos: variáveis com esse prefixo ficam públicas no navegador.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Banco de dados a ser configurado junto do backend.
DATABASE_URL=
